
@model ISFDyT124.Models.Materia

@{
    ViewData["Title"] = "Detalle Materia";
    ViewData["BodyClass"] = "agregar-page";

    var asignacion = Model.CarreraMaterias?
        .OrderBy(cm => cm.CaMaId)
        .FirstOrDefault();

    var dias = asignacion?.DiasCursada?
        .Select(d => d.DiaSemana)
        .Distinct()
        .OrderBy(d => d)
        .ToList()
        ?? new List<DayOfWeek>();

    string NombreDia(DayOfWeek dia) => dia switch
    {
        DayOfWeek.Monday => "Lunes",
        DayOfWeek.Tuesday => "Martes",
        DayOfWeek.Wednesday => "Miércoles",
        DayOfWeek.Thursday => "Jueves",
        DayOfWeek.Friday => "Viernes",
        DayOfWeek.Saturday => "Sábado",
        DayOfWeek.Sunday => "Domingo",
        _ => dia.ToString()
    };
}

<div class="info-banner">
    <div class="info-col-left">
        <p class="info-bold">PANEL DE CONTROL</p>
    </div>
    <div class="info-col-right">
        <p class="info-bold">ADMINISTRADOR</p>
    </div>
</div>

<div class="page-title-container">
    <h2 class="page-main-title">Detalle Materia</h2>
</div>

<main class="main-container-form">
    <div class="form-card">

        <div class="input-field">
            <label>ID Materia</label>
            <input value="@Model.MaId" readonly />
        </div>

        <div class="input-field">
            <label>Denominación</label>
            <input value="@Model.MaDenominacion" readonly />
        </div>

        <div class="input-field">
            <label>Modalidad</label>
            <input value="@Model.MaModalidad" readonly />
        </div>

        <div class="input-field">
            <label>Cantidad de módulos</label>
            <input value="@Model.MaCantModulos" readonly />
        </div>

        <div class="input-field" style="grid-column: span 2;">
            <label>Carrera</label>
            <input value="@(asignacion?.CarreraCohorte?.Carrera?.CaDenominacion ?? "Sin asignar")"
                   readonly />
        </div>

        <div class="input-field">
            <label>Año de cohorte</label>
            <input value="@(asignacion?.CarreraCohorte?.Cohorte?.CoAnio.ToString() ?? "Sin asignar")"
                   readonly />
        </div>

        <div class="input-field" style="grid-column: span 2;">
            <label>Días de cursada</label>
            <input value="@(dias.Any()
                ? string.Join(", ", dias.Select(NombreDia))
                : "Sin días configurados")"
                   readonly />
        </div>

        <div class="form-buttons"
             style="grid-column: span 2; display: flex; justify-content: flex-end; gap: 20px; margin-top: 20px;">

            <a asp-action="Index"
               class="btn-cancel"
               style="text-decoration: none; text-align: center;">
                Volver
            </a>

            <a asp-action="Edit"
               asp-route-MaId="@Model.MaId"
               class="btn-save"
               style="text-decoration: none; text-align: center;">
                Editar
            </a>
        </div>
    </div>
</main>
