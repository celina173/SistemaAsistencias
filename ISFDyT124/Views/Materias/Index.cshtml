@model IEnumerable<ISFDyT124.Models.Materia>

@{
    ViewData["Title"] = "Materias";
    ViewData["BodyClass"] = "gestion-page";
}

<div class="info-banner">
    <div class="info-col-left">
        <p class="info-bold">PANEL DE CONTROL</p>
    </div>
    <div class="info-col-right">
        <p class="info-bold">ADMINISTRADOR</p>
    </div>
</div>

<div class="page-title-container">
    <h2 class="page-main-title">Gestión Materias</h2>
</div>

<main class="main-container-global">

    <div class="toolbar-container">
        <div class="spacer"></div>
        <div class="add-btn-container">
            <a asp-action="Create" class="btn-add" id="btnAgregar" style="text-decoration: none; display: flex; align-items: center; justify-content: center;">+</a>
        </div>
    </div>

    <div class="global-table-container">
        <table class="global-table crud-materias">
            <thead>
                <tr>
                    <th class="align-left sortable" data-type="text">
                        <div class="sort-header">
                            NOMBRE DE LA MATERIA
                            <span class="sort-indicator">▲</span>
                        </div>
                    </th>
                    <th class="sortable" data-type="text">
                        <div class="sort-header">
                            MODALIDAD
                            <span class="sort-indicator">⇅</span>
                        </div>
                    </th>
                    <th class="sortable" data-type="number">
                        <div class="sort-header">
                            MÓDULOS
                            <span class="sort-indicator">⇅</span>
                        </div>
                    </th>
                    <th class="align-left sortable" data-type="number">
                        <div class="sort-header">
                            CARRERAS RELACIONADAS
                            <span class="sort-indicator">⇅</span>
                        </div>
                    </th>
                    <th>ACCIONES</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="align-left">@item.MaDenominacion</td>
                            <td>@(item.MaModalidad ?? "-")</td>
                            <td>@(item.MaCantModulos?.ToString() ?? "-")</td>
                            <td class="align-left">@(item.CarreraMaterias?.Count ?? 0)</td>
                            <td class="action-cell">
                                <div class="action-buttons">
                                    <a asp-action="Edit" asp-route-MaId="@item.MaId" class="icon-btn btn-edit" title="Editar">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 1 1 3 3L12 15l-4 1 1-4Z"></path></svg>
                                    </a>
                                    <a asp-action="Details" asp-route-MaId="@item.MaId" class="icon-btn" title="Detalles">📋</a>
                                    <a asp-action="Delete" asp-route-MaId="@item.MaId" class="icon-btn" title="Eliminar">🗑️</a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" style="text-align:center;">No hay materias cargadas todavía.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</main>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const table = document.querySelector('.crud-materias');
        if (!table) return;

        const tbody = table.querySelector('tbody');
        let rows = Array.from(tbody.querySelectorAll('tr'));
        
        if (rows.length <= 1 && rows[0]?.querySelector('td[colspan]')) return;

        const headers = Array.from(table.querySelectorAll('thead th'));
        const collator = new Intl.Collator('es', { sensitivity: 'base', numeric: true });

        let activeCol = -1;
        let isAsc = false;
        let activeTh = null;

        table.querySelector('thead').addEventListener('click', function (e) {
            const th = e.target.closest('th.sortable');
            if (!th) return;

            const colIndex = headers.indexOf(th);
            const isSameCol = (colIndex === activeCol);

            if (isSameCol) {
                isAsc = !isAsc;
                rows.reverse();
            } else {
                if (activeTh) {
                    activeTh.classList.remove('sorted-asc', 'sorted-desc');
                    const prevIndicator = activeTh.querySelector('.sort-indicator');
                    if (prevIndicator) prevIndicator.textContent = '⇅';
                }

                activeCol = colIndex;
                activeTh = th;
                isAsc = true;
                
                const isNumber = th.getAttribute('data-type') === 'number';
                const parsed = rows.map(tr => {
                    const text = tr.children[colIndex]?.textContent.trim() ?? '';
                    return {
                        tr,
                        val: isNumber ? (parseFloat(text.replace(',', '.')) || 0) : text
                    };
                });
                
                if (isNumber) {
                    parsed.sort((a, b) => a.val - b.val);
                } else {
                    parsed.sort((a, b) => collator.compare(a.val, b.val));
                }

                rows = parsed.map(item => item.tr);
            }
            
            th.classList.remove('sorted-asc', 'sorted-desc');
            th.classList.add(isAsc ? 'sorted-asc' : 'sorted-desc');
            const indicator = th.querySelector('.sort-indicator');
            if (indicator) {
                indicator.textContent = isAsc ? '▲' : '▼';
            }

            // Single atomic DOM update (triggers 1 reflow instead of N)
            tbody.append(...rows);
        });

        // Trigger default sort by Nombre de la Materia
        headers[0]?.click();
    });
</script>
}
