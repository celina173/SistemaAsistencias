@model ISFDyT124.Models.Materia

@{
    ViewData["Title"] = "Eliminar Materia";
    ViewData["BodyClass"] = "agregar-page";
}

<div class="info-banner">
    <div class="info-col-left">
        <p class="info-bold">PANEL DE CONTROL</p>
    </div>
    <div class="info-col-right">
        <p class="info-bold">ADMINISTRADOR</p>
    </div>
</div>

<div class="page-title-container">
    <h2 class="page-main-title">Eliminar Materia</h2>
</div>

<main class="main-container-form">
    <div class="form-card">
        <h3>¿Está seguro de eliminar esta materia?</h3>

        <dl class="row">
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.MaDenominacion)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.MaDenominacion)</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.MaModalidad)</dt>
            <dd class="col-sm-8">@(Model.MaModalidad ?? "-")</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.MaCantModulos)</dt>
            <dd class="col-sm-8">@(Model.MaCantModulos?.ToString() ?? "-")</dd>
        </dl>

        <form asp-action="Delete">
            <input type="hidden" asp-for="MaId" />
            <div class="form-buttons">
                <a asp-action="Index" class="btn-cancel" style="text-decoration:none; text-align:center;">Cancelar</a>
                <button type="submit" class="btn-save">Eliminar</button>
            </div>
        </form>
    </div>
</main>
