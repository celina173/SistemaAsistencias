@model IEnumerable<ISFDyT124.DTO.AuditoriaDocenteDto>

@{
    ViewData["Title"] = "Auditoría de Docentes";
    ViewData["BodyClass"] = "global-page";
}

<main class="main-container-global">

    <div class="info-banner">
        <div class="info-col-left">
            <p class="info-bold">Actividad de carga de asistencia por cátedra</p>
        </div>
        <div class="info-col-right">
            <p class="info-bold">ADMINISTRADOR</p>
        </div>
    </div>

    <!-- BOTÓN VOLVER ATRÁS -->
    <div class="contenedor-volver">
        <a asp-controller="Admin" asp-action="Index" class="btn-volver-atras" title="Volver al Panel de Control">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            Volver al Panel
        </a>
    </div>

    <div class="global-table-container">
        <table class="global-table table-responsive-stack">
            <thead>
                <tr>
                    <th colspan="6" class="title-cell">Auditoría de Docentes</th>
                </tr>
                <tr>
                    <th class="align-left">Docente</th>
                    <th class="align-left">Carrera / Materia</th>
                    <th>Alumnos</th>
                    <th>Fechas cargadas</th>
                    <th class="total-col">Última carga</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var fila in Model)
                    {
                        <tr>
                            <td class="align-left" data-label="Docente">@fila.DocenteNombre</td>
                            <td class="align-left" data-label="Carrera / Materia">@fila.CarreraDenominacion / @fila.MateriaDenominacion</td>
                            <td data-label="Alumnos">@fila.CantidadAlumnos</td>
                            <td data-label="Fechas cargadas">@fila.CantidadFechasCargadas</td>
                            <td class="total-col" data-label="Última carga">@(fila.UltimaFechaCargada.HasValue ? fila.UltimaFechaCargada.Value.ToString("dd/MM/yyyy") : "-")</td>
                            <td data-label="Estado">
                                @if (fila.UltimaFechaCargada.HasValue)
                                {
                                    <span>Con actividad</span>
                                }
                                else
                                {
                                    <span style="color:#ef4444; font-weight:700;">Sin actividad</span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6">No hay docentes con cátedras asignadas todavía.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</main>
