@model ISFDyT124.DTO.UsuarioCrearDto
@{
    ViewData["Title"] = "Agregar Usuario";
    ViewData["BodyClass"] = "agregar-page";
}

<!-- BANNER OFICIAL -->
<div class="info-banner">
    <div class="info-col-left">
        <p class="info-bold">PANEL DE CONTROL</p>
    </div>
    <div class="info-col-right">
        <p class="info-bold">ADMINISTRADOR</p>
    </div>
</div>

<div class="page-title-container">
    <h2 class="page-main-title">Agregar Usuario</h2>
</div>

<main class="main-container-form">
    <div class="form-card">
        <form asp-controller="Admin" asp-action="UsuarioAgregar" method="post" id="formAgregarUsuario" class="form-grid" novalidate>
            <div asp-validation-summary="ModelOnly" class="text-danger" style="grid-column: span 2;"></div>

            <div class="input-field">
                <label asp-for="UsApellido">Apellidos *</label>
                <input asp-for="UsApellido" autocomplete="off" placeholder="Ej: Albornoz">
                <span asp-validation-for="UsApellido" class="text-danger"></span>
            </div>

            <div class="input-field">
                <label asp-for="UsNombre">Nombres *</label>
                <input asp-for="UsNombre" autocomplete="off" placeholder="Ej: Celina">
                <span asp-validation-for="UsNombre" class="text-danger"></span>
            </div>

            <div class="input-field">
                <label asp-for="UsDni">DNI *</label>
                <input asp-for="UsDni" type="text" inputmode="numeric" autocomplete="new-password" value="" placeholder="Ej: 39123456">
                <span asp-validation-for="UsDni" class="text-danger"></span>
            </div>

            <div class="input-field">
                <label asp-for="UsEmail">Email *</label>
                <input asp-for="UsEmail" autocomplete="new-password" placeholder="Ej: correo@instituto.com">
                <span asp-validation-for="UsEmail" class="text-danger"></span>
            </div>

            <div class="input-field" style="grid-column: span 2;">
                <label for="selectedRoleId">Rol del Usuario *</label>
                <select id="selectedRoleId" name="selectedRoleId" required
                        asp-items="@(new SelectList(ViewBag.RolesList, "RoId", "RoDenominacion"))">
                    <option value="" disabled selected>Seleccione un Rol</option>
                </select>
            </div>

            <div id="carreraCohorteGroup" class="input-field" style="display:none; grid-column: span 2;">
                <label asp-for="CaCoId">Carrera / Cohorte *</label>
                <select asp-for="CaCoId" data-msg-required="Debe seleccionar una Carrera / Cohorte para un Estudiante.">
                    <option value="">Seleccione Carrera / Cohorte</option>
                    @foreach (var cc in ViewBag.CarreraCohortesList)
                    {
                        <option value="@cc.CaCoId">@cc.Denominacion</option>
                    }
                </select>
                <span asp-validation-for="CaCoId" class="text-danger"></span>
            </div>

            <div id="materiasGroup" class="input-field" style="display:none; grid-column: span 2;">
                <label>Materias Asignadas</label>
                <div id="materiasList" class="materias-checklist" role="group" aria-label="Materias asignadas">
                    @foreach (var cm in ViewBag.CarreraMateriasList)
                    {
                        var materiaId = $"materia_{cm.CaMaId}";
                        <label class="materia-check" for="@materiaId">
                            <input class="materia-check__input"
                                   type="checkbox"
                                   id="@materiaId"
                                   name="SelectedCaMaIds"
                                   value="@cm.CaMaId"
                                   checked="@(Model.SelectedCaMaIds?.Contains(cm.CaMaId) == true ? "checked" : null)" />
                            <span class="materia-check__label">@cm.Denominacion</span>
                        </label>
                    }
                </div>
                <span asp-validation-for="SelectedCaMaIds" class="text-danger"></span>
                <span id="selectedCaMaError" class="text-danger" style="display:none;"></span>
            </div>

            <div class="input-field" style="grid-column: span 2;">
                <label for="userPassword">Contraseña Inicial (Opcional)</label>
                <input type="password" id="userPassword" name="userPassword" autocomplete="new-password" placeholder="Para mayor seguridad, cambie la contraseña al iniciar sesión. Si no, seguirá siendo su DNI.">
            </div>

            <div class="form-buttons" style="grid-column: span 2; display: flex; justify-content: flex-end; gap: 20px; margin-top: 20px;">
                <a asp-action="UsuariosABM" class="btn-cancel" style="text-decoration:none; text-align:center;">Cancelar</a>
                <button type="submit" class="btn-save">Guardar Usuario</button>
            </div>
        </form>
    </div>
</main>

<style>
    #materiasList.materias-checklist {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
        gap: 6px 16px;
        max-height: 220px;
        overflow-y: auto;
        border: 1px solid #e6e6e6;
        padding: 8px;
        border-radius: 6px;
    }

    #materiasList .materia-check {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        min-width: 0;
        margin: 0;
        padding: 5px 4px;
        cursor: pointer;
        line-height: 1.35;
    }

    #materiasList .materia-check__input {
        flex: 0 0 auto;
        width: 1rem;
        height: 1rem;
        margin: 0.18rem 0 0;
    }

    #materiasList .materia-check__label {
        min-width: 0;
        overflow-wrap: anywhere;
    }

    @@media (max-width: 576px) {
        #materiasList.materias-checklist {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        var roleSelect = document.getElementById('selectedRoleId');
        var caCoIdSelect = document.getElementById('CaCoId');
        var materiasGroup = document.getElementById('materiasGroup');
        var materiasCheckboxes = document.querySelectorAll('#materiasList input[type=checkbox]');

        function toggleFields() {
            var val = parseInt(roleSelect.value);
            var esEstudiante = val === 3;
            var esDocente = val === 2;

            document.getElementById('carreraCohorteGroup').style.display = esEstudiante ? 'flex' : 'none';
            document.getElementById('materiasGroup').style.display = esDocente ? 'flex' : 'none';
            caCoIdSelect.required = esEstudiante;

            materiasCheckboxes.forEach(function (cb) { cb.required = false; });
            if (esDocente && materiasCheckboxes.length > 0) {
                materiasCheckboxes[0].required = true;
            }
        }

        roleSelect.addEventListener('change', toggleFields);
        toggleFields();

        document.getElementById('formAgregarUsuario').addEventListener('submit', function (e) {
            var val = parseInt(roleSelect.value);
            if (val === 2) {
                var checked = Array.from(document.querySelectorAll('#materiasList input[type=checkbox]:checked'));
                if (checked.length === 0) {
                    e.preventDefault();
                    document.getElementById('selectedCaMaError').textContent = 'Debe seleccionar al menos una materia para un Docente.';
                    document.getElementById('selectedCaMaError').style.display = 'block';
                    document.getElementById('materiasGroup').scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
            }
        });
    </script>
}