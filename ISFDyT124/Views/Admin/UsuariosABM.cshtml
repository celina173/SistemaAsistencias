@model IEnumerable<ISFDyT124.DTO.UsuarioDetalleDto>
@{
    ViewData["Title"] = "Gestión de Usuarios";
    ViewData["BodyClass"] = "gestion-page";
}

<div class="info-banner">
    <div class="info-col-left">
        <p class="info-bold">PANEL DE CONTROL</p>
    </div>
    <div class="info-col-right">
        <p class="info-bold">ADMINISTRADOR</p>
    </div>
</div>

<div class="page-title-container">
    <h2 class="page-main-title">Gestión Usuarios</h2>
</div>

<main class="main-container-global">

    <div class="toolbar-container" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
        <div>
            <a asp-controller="Admin" asp-action="CargaMasivaAlumnos" class="btn-carga-masiva" style="display: inline-flex; align-items: center; gap: 8px; padding: 8px 16px; border-radius: 6px; text-decoration: none; font-size: 14px; font-weight: 500; background: #e0f2fe; color: #0369a1; border: 1px solid #7dd3fc;">
                <i class="bi bi-file-earmark-spreadsheet-fill"></i> Carga masiva de estudiantes (Excel)
            </a>
        </div>
        <div class="add-btn-container">
            <a asp-controller="Admin" asp-action="UsuarioAgregar" class="btn-add" id="btnAgregar" title="Nuevo Usuario" style="text-decoration: none; display: flex; align-items: center; justify-content: center;">+</a>
        </div>
    </div>

    <div class="global-table-container">
        <table class="global-table crud-usuarios">
            <thead>
                <tr>
                    <th class="align-left">APELLIDO Y NOMBRE</th>
                    <th>DNI</th>
                    <th>ROL</th>
                    <th class="align-left">CARRERA / COHORTE</th>
                    <th class="align-left">MATERIAS</th>
                    <th>ACCIONES</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="align-left">@item.UsApellido, @item.UsNombre</td>
                            <td>@item.UsDni</td>
                            <td>@(item.RoDenominacion ?? "Sin Rol")</td>
                            <td class="align-left">@(item.CarreraCohorteDenominacion ?? "-")</td>
                            <td class="align-left" style="font-size:0.85em;">@(item.MateriasDenominacion ?? "-")</td>
                            <td class="action-cell">
                                <div class="action-buttons">
                                    <a asp-action="UsuarioEditar" asp-route-id="@item.UsId" class="icon-btn btn-edit" title="Editar">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 1 1 3 3L12 15l-4 1 1-4Z"></path></svg>
                                    </a>
                                    <form asp-action="UsuarioEliminar" asp-route-id="@item.UsId" method="post" style="display:inline;" onsubmit="return confirm('¿Está seguro de eliminar este usuario?');">
                                        <button type="submit" class="icon-btn" style="border:none; background:none; cursor:pointer;" title="Eliminar">🗑️</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" style="text-align:center;">No hay usuarios cargados todavía.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</main>
