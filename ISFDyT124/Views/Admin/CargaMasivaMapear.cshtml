@model ISFDyT124.DTO.CargaMasivaMapeoDto
@{
    ViewData["Title"] = "Carga Masiva de Estudiantes - Paso 2: Mapeo de Columnas";
    ViewData["BodyClass"] = "agregar-page";
}

<div class="admin-banner">
    ADMINISTRADOR
</div>

<div class="page-title-container">
    <h2 class="page-main-title">Mapeo de Columnas de Estudiantes</h2>
</div>

<main class="main-container-form">
    <!-- Indicador de pasos (Wizard) -->
    <div class="wizard-steps-container" style="display: flex; justify-content: center; gap: 20px; margin-bottom: 25px;">
        <div class="step-item completed" style="display: flex; align-items: center; gap: 8px; color: #16a34a; border-bottom: 3px solid #16a34a; padding-bottom: 6px;">
            <span class="step-number" style="background: #16a34a; color: white; border-radius: 50%; width: 26px; height: 26px; display: inline-flex; align-items: center; justify-content: center; font-size: 13px;">
                <i class="bi bi-check"></i>
            </span>
            <span>Archivo y Carrera</span>
        </div>
        <div class="step-item active" style="display: flex; align-items: center; gap: 8px; font-weight: bold; color: #1a73e8; border-bottom: 3px solid #1a73e8; padding-bottom: 6px;">
            <span class="step-number" style="background: #1a73e8; color: white; border-radius: 50%; width: 26px; height: 26px; display: inline-flex; align-items: center; justify-content: center; font-size: 13px;">2</span>
            <span>Mapeo de Columnas</span>
        </div>
        <div class="step-item" style="display: flex; align-items: center; gap: 8px; color: #888; border-bottom: 3px solid #ddd; padding-bottom: 6px;">
            <span class="step-number" style="background: #ddd; color: #555; border-radius: 50%; width: 26px; height: 26px; display: inline-flex; align-items: center; justify-content: center; font-size: 13px;">3</span>
            <span>Resultado y Reporte</span>
        </div>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger" style="background: #fde8e8; color: #c81e1e; border: 1px solid #f8b4b4; padding: 12px 16px; border-radius: 8px; margin-bottom: 20px;">
            <div asp-validation-summary="All" style="margin: 0; padding-left: 20px;"></div>
        </div>
    }

    <div class="form-card" style="max-width: 900px; margin: 0 auto;">
        <!-- Resumen de selección del Paso 1 -->
        <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 16px; margin-bottom: 25px;">
            <div style="display: flex; flex-wrap: wrap; gap: 20px; font-size: 14px;">
                <div>
                    <span style="color: #64748b; font-size: 12px; display: block; text-transform: uppercase; font-weight: 600;">Carrera / Cohorte asignada:</span>
                    <strong style="color: #0f172a; font-size: 15px;"><i class="bi bi-mortarboard-fill" style="color: #1a73e8; margin-right: 6px;"></i> @Model.CarreraCohorteDenominacion</strong>
                </div>
                <div>
                    <span style="color: #64748b; font-size: 12px; display: block; text-transform: uppercase; font-weight: 600;">Materias a inscribir (@Model.SelectedCaMaIds.Count):</span>
                    <div style="display: flex; flex-wrap: wrap; gap: 6px; margin-top: 4px;">
                        @foreach (var mat in Model.MateriasSeleccionadasNombres)
                        {
                            <span style="background: #e0e7ff; color: #3730a3; padding: 2px 8px; border-radius: 4px; font-size: 12px; font-weight: 500;">
                                @mat
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <form asp-controller="Admin" asp-action="CargaMasivaPrevisualizar" method="post" id="formMapeoColumnas">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="TempFileToken" />
            <input type="hidden" asp-for="CaCoId" />
            <input type="hidden" name="FechaInscripcion" value="@(Model.FechaInscripcion?.ToString("yyyy-MM-dd"))" />
            @foreach (var id in Model.SelectedCaMaIds)
            {
                <input type="hidden" name="SelectedCaMaIds" value="@id" />
            }

            <div style="margin-bottom: 20px;">
                <h3 style="font-size: 16px; color: #1e293b; margin-bottom: 6px; font-weight: 600;">
                    <i class="bi bi-columns-gap" style="color: #1a73e8; margin-right: 8px;"></i> Elija las pestañas a cargar y las columnas de cada una
                </h3>
                <p style="color: #64748b; font-size: 13px; margin: 0;">
                    Cada pestaña se lee por separado: marque las que tienen alumnos, indique en qué fila están los títulos y qué columna es cada dato.
                    El sistema propone la mejor coincidencia; revísela y corríjala si hace falta. Los alumnos repetidos en varias pestañas se consolidan si sus datos coinciden.
                </p>
            </div>

            @for (int i = 0; i < Model.Hojas.Count; i++)
            {
                var hoja = Model.Hojas[i];
                <section class="hoja-card" data-hoja="@hoja.Nombre" style="margin-bottom: 18px; border: 1px solid #cbd5e1; border-radius: 8px; background: white; opacity:@(hoja.TieneDatos ? "1" : ".55");">
                    <input type="hidden" name="Hojas[@i].Nombre" value="@hoja.Nombre" />
                    <label style="display:flex; align-items:center; gap:10px; padding: 12px 14px; background:#f8fafc; border-radius: 8px 8px 0 0; cursor:@(hoja.TieneDatos ? "pointer" : "not-allowed");">
                        <input type="checkbox" class="hoja-incluir" name="Hojas[@i].Incluir" value="true"
                               checked="@(hoja.Incluir ? "checked" : null)" disabled="@(!hoja.TieneDatos)" />
                        <input type="hidden" name="Hojas[@i].Incluir" value="false" />
                        <strong>@hoja.Nombre</strong>
                        <small style="color:#64748b;">(@hoja.TotalFilas filas@(hoja.TieneDatos ? "" : ", sin datos"))</small>
                    </label>

                    @if (hoja.TieneDatos)
                    {
                        <div class="hoja-cuerpo" style="padding: 14px; display:@(hoja.Incluir ? "block" : "none");">
                            <div style="display:flex; flex-wrap:wrap; gap:16px; align-items:flex-end; margin-bottom: 14px;">
                                <div>
                                    <label style="font-weight: 600; display:block; margin-bottom: 4px; font-size: 13px;">Fila de los títulos</label>
                                    <input type="number" min="1" class="form-control hoja-fila" name="Hojas[@i].FilaCabecera" value="@hoja.FilaCabecera"
                                           style="width: 90px; padding: 8px; border-radius: 6px; border: 1px solid #cbd5e1;" />
                                </div>
                                <label style="font-size: 13px; display:flex; align-items:center; gap:6px; padding-bottom: 8px;">
                                    <input type="checkbox" class="hoja-combinada" name="Hojas[@i].ApellidoYNombre" value="true"
                                           checked="@(hoja.ApellidoYNombre ? "checked" : null)" />
                                    <input type="hidden" name="Hojas[@i].ApellidoYNombre" value="false" />
                                    El apellido y el nombre están en la misma columna
                                </label>
                            </div>

                            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; margin-bottom: 16px;">
                                @{
                                    var campos = new[]
                                    {
                                        (Clave: "Dni", Titulo: "DNI *", Valor: hoja.ColDni, Fondo: "#f0f9ff", Borde: "#bae6fd", Ayuda: "7 a 8 dígitos numéricos"),
                                        (Clave: "Apellido", Titulo: "Apellido *", Valor: hoja.ColApellido, Fondo: "#fdf4ff", Borde: "#f5d0fe", Ayuda: hoja.ApellidoYNombre ? "Apellido y nombre juntos" : "Solo letras y espacios"),
                                        (Clave: "Nombre", Titulo: "Nombre *", Valor: hoja.ColNombre, Fondo: "#f0fdf4", Borde: "#bbf7d0", Ayuda: "Solo letras y espacios"),
                                        (Clave: "Email", Titulo: "Email *", Valor: hoja.ColEmail, Fondo: "#fffbeb", Borde: "#fde68a", Ayuda: "Formato de correo válido"),
                                    };
                                }
                                @foreach (var campo in campos)
                                {
                                    <div class="campo-@campo.Clave.ToLower()" style="background: @campo.Fondo; border: 1px solid @campo.Borde; border-radius: 8px; padding: 12px; display:@(campo.Clave == "Nombre" && hoja.ApellidoYNombre ? "none" : "block");">
                                        <label style="font-weight: 600; display: block; margin-bottom: 6px;">@campo.Titulo</label>
                                        <select class="form-control hoja-col" data-campo="@campo.Clave" name="Hojas[@i].Col@(campo.Clave)"
                                                disabled="@(campo.Clave == "Nombre" && hoja.ApellidoYNombre)"
                                                style="width: 100%; padding: 8px; border-radius: 6px; border: 1px solid #cbd5e1; background: white;">
                                            <option value="0" selected="@(campo.Valor == 0 ? "selected" : null)">-- Seleccione columna --</option>
                                            @for (int c = 0; c < hoja.Columnas.Count; c++)
                                            {
                                                var titulo = string.IsNullOrWhiteSpace(hoja.Columnas[c]) ? "(sin título)" : hoja.Columnas[c];
                                                <option value="@(c + 1)" selected="@(campo.Valor == c + 1 ? "selected" : null)">@ISFDyT124.Services.ExcelImportService.LetraColumna(c + 1) · @titulo</option>
                                            }
                                        </select>
                                        <small style="display: block; margin-top: 4px; font-size: 11px; color:#475569;">@campo.Ayuda</small>
                                    </div>
                                }
                            </div>

                            <div style="overflow-x: auto; border: 1px solid #e2e8f0; border-radius: 8px;">
                                <table class="hoja-preview" style="width: 100%; border-collapse: collapse; font-size: 13px; text-align: left;">
                                    <thead style="background: #f1f5f9; color: #334155;">
                                        <tr>
                                            @for (int c = 0; c < hoja.Columnas.Count; c++)
                                            {
                                                <th style="padding: 8px 12px; border-bottom: 2px solid #cbd5e1; font-weight: 600; white-space: nowrap;">
                                                    <span style="color:#94a3b8; font-weight:500;">@ISFDyT124.Services.ExcelImportService.LetraColumna(c + 1)</span> @hoja.Columnas[c]
                                                </th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (hoja.PreviewRows.Any())
                                        {
                                            foreach (var fila in hoja.PreviewRows)
                                            {
                                                <tr style="border-bottom: 1px solid #f1f5f9;">
                                                    @foreach (var valor in fila)
                                                    {
                                                        <td style="padding: 6px 12px; max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                                            @(string.IsNullOrWhiteSpace(valor) ? "—" : valor)
                                                        </td>
                                                    }
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr><td colspan="@Math.Max(1, hoja.Columnas.Count)" style="padding: 16px; text-align: center; color: #64748b;">No hay filas con datos debajo de la fila de títulos.</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <small class="hoja-aviso" style="color:#64748b; display:block; margin-top:6px;">Muestra de las primeras filas bajo la fila @hoja.FilaCabecera.</small>
                        </div>
                    }
                </section>
            }

            <div class="form-buttons" style="display: flex; justify-content: space-between; margin-top: 25px;">
                <a asp-action="CargaMasivaAlumnos" class="btn-cancel" style="text-decoration:none; text-align:center; padding: 10px 20px; border-radius: 6px;">
                    <i class="bi bi-arrow-left" style="margin-right: 6px;"></i> Cambiar archivo / Carrera
                </a>
                <button type="submit" class="btn-save" id="btnProcesarImportacion" style="padding: 10px 24px; border-radius: 6px; background: #16a34a; color: white; border: none; cursor: pointer; font-weight: 600; font-size: 14px;">
                    <i class="bi bi-eye" style="margin-right: 6px;"></i> Generar previsualización editable
                </button>
            </div>
        </form>
    </div>
</main>

@section Scripts {
    <script>
        (function () {
            var urlColumnas = '@Url.Action("CargaMasivaColumnas", "Admin")';
            var token = '@Model.TempFileToken';
            var campos = ['Dni', 'Apellido', 'Nombre', 'Email'];

            function letra(n) {
                var s = '';
                while (n > 0) { var r = (n - 1) % 26; s = String.fromCharCode(65 + r) + s; n = Math.floor((n - 1) / 26); }
                return s;
            }

            function llenarSelect(select, columnas, valor) {
                select.innerHTML = '';
                var vacio = document.createElement('option');
                vacio.value = '0';
                vacio.textContent = '-- Seleccione columna --';
                select.appendChild(vacio);
                columnas.forEach(function (titulo, i) {
                    var op = document.createElement('option');
                    op.value = String(i + 1);
                    op.textContent = letra(i + 1) + ' · ' + (titulo.trim() === '' ? '(sin título)' : titulo);
                    select.appendChild(op);
                });
                select.value = String(valor || 0);
            }

            function dibujarMuestra(card, datos) {
                var tabla = card.querySelector('.hoja-preview');
                tabla.innerHTML = '';
                var cab = tabla.createTHead().insertRow();
                datos.columnas.forEach(function (titulo, i) {
                    var th = document.createElement('th');
                    th.style.cssText = 'padding:8px 12px;border-bottom:2px solid #cbd5e1;font-weight:600;white-space:nowrap;';
                    var l = document.createElement('span');
                    l.style.cssText = 'color:#94a3b8;font-weight:500;';
                    l.textContent = letra(i + 1);
                    th.appendChild(l);
                    th.appendChild(document.createTextNode(' ' + titulo));
                    cab.appendChild(th);
                });
                var cuerpo = tabla.createTBody();
                if (datos.filas.length === 0) {
                    var td = cuerpo.insertRow().insertCell();
                    td.colSpan = Math.max(1, datos.columnas.length);
                    td.style.cssText = 'padding:16px;text-align:center;color:#64748b;';
                    td.textContent = 'No hay filas con datos debajo de la fila de títulos.';
                } else {
                    datos.filas.forEach(function (fila) {
                        var tr = cuerpo.insertRow();
                        tr.style.borderBottom = '1px solid #f1f5f9';
                        fila.forEach(function (valor) {
                            var td = tr.insertCell();
                            td.style.cssText = 'padding:6px 12px;max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;';
                            td.textContent = valor.trim() === '' ? '—' : valor;
                        });
                    });
                }
                card.querySelector('.hoja-aviso').textContent = 'Muestra de las primeras filas bajo la fila ' + datos.filaCabecera + '.';
            }

            function aplicarCombinada(card) {
                var combinada = card.querySelector('.hoja-combinada').checked;
                var contenedor = card.querySelector('.campo-nombre');
                contenedor.style.display = combinada ? 'none' : 'block';
                contenedor.querySelector('select').disabled = combinada;
            }

            function recargar(card, fila) {
                var url = urlColumnas + '?token=' + encodeURIComponent(token) +
                    '&hoja=' + encodeURIComponent(card.dataset.hoja) + (fila ? '&fila=' + encodeURIComponent(fila) : '');
                fetch(url, { credentials: 'same-origin' })
                    .then(function (r) { if (!r.ok) throw new Error(); return r.json(); })
                    .then(function (datos) {
                        card.querySelector('.hoja-fila').value = datos.filaCabecera;
                        campos.forEach(function (campo) {
                            llenarSelect(card.querySelector('select[data-campo="' + campo + '"]'), datos.columnas, datos.sugerido[campo.toLowerCase()]);
                        });
                        card.querySelector('.hoja-combinada').checked = datos.sugerido.apellidoYNombre;
                        aplicarCombinada(card);
                        dibujarMuestra(card, datos);
                    })
                    .catch(function () {
                        card.querySelector('.hoja-aviso').textContent = 'No se pudieron leer las columnas de esa fila. Pruebe con otra.';
                    });
            }

            document.querySelectorAll('.hoja-card').forEach(function (card) {
                var incluir = card.querySelector('.hoja-incluir');
                var cuerpo = card.querySelector('.hoja-cuerpo');
                if (!cuerpo) return;
                incluir.addEventListener('change', function () { cuerpo.style.display = incluir.checked ? 'block' : 'none'; });
                card.querySelector('.hoja-fila').addEventListener('change', function (e) { recargar(card, e.target.value); });
                card.querySelector('.hoja-combinada').addEventListener('change', function () { aplicarCombinada(card); });
            });
        })();
    </script>
}
