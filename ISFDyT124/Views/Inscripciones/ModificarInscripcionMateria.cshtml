@using Microsoft.AspNetCore.Mvc.Rendering
@model ISFDyT124.Models.Inscripciones
@{
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modificar Inscripción - Sistema de Asistencias</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="style.css">
</head>
<body class="agregar-page gestion-page modificar-inscripcion">

    <header class="top-header">
        <div class="menu-icon">
            <div class="bar"></div>
            <div class="bar"></div>
            <div class="bar"></div>
        </div>

        <div class="header-title">
            <span class="title-small">INSTITUTO N° 124</span>
            <h1 class="title-large">SISTEMA DE ASISTENCIAS</h1>
        </div>

        <div class="header-logo">
            <img src="img/logo.webp" alt="IS 124" class="logo-img">
        </div>
    </header>

    <nav class="sidebar" id="sidebarMenu">
        <ul class="sidebar-links">
            <li><a asp-controller="Home" asp-action="Index">Inicio</a></li>
            <li><a asp-controller="Asistencias" asp-action="AsistenciaGlobal">Calendario</a></li>
            <li class="menu-divider"></li>
            <li><a asp-controller="Inscripciones" asp-action="GestionInscripcionesMaterias">Volver a Gestión</a></li>
            <li class="logout"><a asp-controller="Home" asp-action="Logout">Cerrar Sesión</a></li>
        </ul>
    </nav>

    <div class="header-divider"></div>

    <div class="info-banner">
        <div class="info-col-left">
            <p class="info-bold">GESTIÓN DE INSCRIPCIONES</p>
        </div>
        <div class="info-col-right">
            <p class="info-bold">MODIFICAR REGISTRO</p>
        </div>
    </div>

    <main class="main-container-form">
        <div class="form-card">
            <div class="form-header">
                <h2 class="form-main-title">MODIFICAR INSCRIPCION A MATERIA</h2>
                <div class="form-title-divider"></div>
            </div>

                <form asp-action="ModificarInscripcionMateria" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="InId" />
                    <input type="hidden" asp-for="UsId" />
    
                    <div class="form-grid">
                        <div class="input-field" style="grid-column: span 2;">
                            <label>Alumno</label>
                            <input type="text" value="@(Model.Usuarios != null ? (Model.Usuarios.UsApellido + " " + Model.Usuarios.UsNombre) : "")" readonly style="background-color: #f0f0f0;">
                        </div>

                        <!-- 1. FILTRO CARRERA/COHORTE -->
                        <div class="input-field" style="grid-column: span 2;">
                            <label>1. Filtrar por Carrera / Cohorte</label>
                            <select id="filtroCarrera">
                                <option value="">-- Todas las carreras --</option>
                                @{
                                    var listaCatedras = ViewData["CaMaId"] as SelectList;
                                    var carrerasUnicas = new HashSet<string>();
                    
                                    if (listaCatedras != null)
                                    {
                                        foreach(var item in listaCatedras)
                                        {
                                            // Extrae la parte de la carrera (antes del ' - ')
                                            var partes = item.Text.Split(" - ");
                                            if(partes.Length > 0 && !carrerasUnicas.Contains(partes[0]))
                                            {
                                                carrerasUnicas.Add(partes[0]);
                                                <option value="@partes[0]">@partes[0]</option>
                                            }
                                        }
                                    }
                                }
                            </select>
                        </div>

                        <!-- 2. SELECTOR DE MATERIA (Filtrado) -->
                        <div class="input-field" style="grid-column: span 2;">
                            <label for="CaMaId">2. Seleccionar Materia</label>
                            <select asp-for="CaMaId" id="CaMaId" required>
                                <option value="">-- Seleccione una Materia --</option>
                                @if(listaCatedras != null)
                                {
                                    foreach(var item in listaCatedras)
                                    {
                                        var partes = item.Text.Split(" - ");
                                        var carreraText = partes.Length > 0 ? partes[0] : "";
                                        var materiaText = partes.Length > 1 ? string.Join(" - ", partes.Skip(1)) : item.Text;
                        
                                        <option value="@item.Value" data-carrera="@carreraText" selected="@(item.Selected ? "selected" : null)">
                                            @materiaText
                                        </option>
                                    }
                                }
                            </select>
                            @Html.ValidationMessageFor(m => m.CaMaId, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-buttons">
                        <a asp-controller="Inscripciones" asp-action="GestionInscripcionesMaterias" class="btn-cancel">Cancelar</a>
                        <button type="submit" class="btn-save">Guardar Cambios</button>
                    </div>
                </form>

                <!-- SCRIPT PARA FILTRAR EL COMBOBOX -->
                <script>
                    document.addEventListener('DOMContentLoaded', function () {
                        var filtroCarrera = document.getElementById('filtroCarrera');
                        var selectMateria = document.getElementById('CaMaId');
                        var opcionesMateria = Array.from(selectMateria.options);

                        // Preseleccionar el filtro si ya hay una materia elegida
                        var opcionSeleccionada = selectMateria.options[selectMateria.selectedIndex];
                        if (opcionSeleccionada && opcionSeleccionada.value !== "") {
                            var carreraDeMateria = opcionSeleccionada.getAttribute('data-carrera');
                            if (carreraDeMateria) {
                                filtroCarrera.value = carreraDeMateria;
                            }
                        }

                        function actualizarFiltro() {
                            var carreraFiltro = filtroCarrera.value;
            
                            // Ocultar/Mostrar opciones según filtro
                            opcionesMateria.forEach(function(opcion) {
                                if (opcion.value === "") return; // Mantiene el placeholder
                
                                var carreraOpcion = opcion.getAttribute('data-carrera');
                                if (carreraFiltro === "" || carreraOpcion === carreraFiltro) {
                                    opcion.style.display = '';
                                } else {
                                    opcion.style.display = 'none';
                                }
                            });

                            // Si la opción seleccionada quedó oculta, resetear el select
                            if (selectMateria.selectedIndex > 0) {
                                var seleccionActual = selectMateria.options[selectMateria.selectedIndex];
                                if (seleccionActual.style.display === 'none') {
                                    selectMateria.value = "";
                                }
                            }
                        }

                        filtroCarrera.addEventListener('change', actualizarFiltro);
                        actualizarFiltro(); // Ejecutar al cargar
                    });
                </script>
        </div>
    </main>

    <script src="script.js"></script>
</body>
</html>
