@model ISFDyT124.DTO.HomeIndexDto

@{
    ViewData["Title"] = "Inicio";
    ViewData["BodyClass"] = "inicio-page";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="info-banner"><div class="info-col-left"><p class="info-bold">@TempData["SuccessMessage"]</p></div></div>
}

<div class="page-title-container">
    <h2 class="page-main-title">Gestión de Asistencia</h2>
    <p class="page-subtitle" style="text-align: center; color: var(--text-muted); font-size: 0.95rem; margin-top: 5px;">Seleccione la carrera y materia para continuar</p>
</div>

<main class="main-container-form">
    <div class="form-card">
        <form asp-controller="Asistencias" asp-action="Index" method="get" class="form-grid" id="formAsistenciaIndex">
            
            <div class="input-field" style="grid-column: span 2;">
                <label for="filtroCarrera">1. Seleccionar Carrera / Cohorte</label>
                <select id="filtroCarrera" class="custom-select" required>
                    <option value="">-- Seleccione una Carrera --</option>
                    @{
                        // ACÁ CAMBIAMOS dynamic POR EL TIPO EXACTO DEL DTO
                        var catedras = ViewBag.Catedras as IEnumerable<ISFDyT124.DTO.CarreraMateriaDetalleDto>;
                        var carrerasUnicas = new HashSet<string>();
                        
                        if (catedras != null)
                        {
                            foreach(var item in catedras)
                            {
                                if(carrerasUnicas.Add(item.CarreraDenominacion))
                                {
                                    <option value="@item.CarreraDenominacion">@item.CarreraDenominacion</option>
                                }
                            }
                        }
                    }
                </select>
            </div>

            <div class="input-field" style="grid-column: span 2;">
                <label for="selectedCaMaId">2. Seleccionar Materia</label>
                <select name="selectedCaMaId" id="selectedCaMaId" aria-label="Filtrar asistencia por materia" class="custom-select" required>
                    <option value="">-- Seleccione una Materia --</option>
                    @if (catedras != null)
                    {
                        foreach(var item in catedras)
                        {
                            // REEMPLAZAMOS LOS NOMBRES DE LAS PROPIEDADES POR LAS DEL DTO
                            <option value="@item.CaMaId" data-carrera="@item.CarreraDenominacion" style="display:none;">@item.MateriaDenominacion</option>
                        }
                    }
                </select>
            </div>

            <div class="form-buttons" style="grid-column: span 2; justify-content: center; margin-top: 15px;">
                <button type="submit" class="btn-save" id="btnSiguiente" style="width: 100%; padding: 14px;">Configurar Asistencia</button>
            </div>
            <div class="form-buttons" style="grid-column: span 2; justify-content: center; margin-top: 8px;">
                <button type="button" id="btnGlobal" class="btn-save-secondary" style="width:100%; padding:12px;">Ir a Asistencia Global</button>
            </div>
        </form>
    </div>
</main>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        var filtroCarrera = document.getElementById('filtroCarrera');
        var selectMateria = document.getElementById('selectedCaMaId');
        var opcionesMateria = Array.from(selectMateria.options);

        // Filtrado dinámico
        function actualizarFiltro() {
            var carreraFiltro = filtroCarrera.value;
            
            opcionesMateria.forEach(function(opcion) {
                if (opcion.value === "") return; 
                
                var carreraOpcion = opcion.getAttribute('data-carrera');
                if (carreraFiltro !== "" && carreraOpcion === carreraFiltro) {
                    opcion.style.display = '';
                } else {
                    opcion.style.display = 'none';
                }
            });

            // Resetear materia si se oculta la seleccionada
            if (selectMateria.selectedIndex > 0) {
                var seleccionActual = selectMateria.options[selectMateria.selectedIndex];
                if (seleccionActual.style.display === 'none') {
                    selectMateria.value = "";
                }
            }
        }

        filtroCarrera.addEventListener('change', actualizarFiltro);
        actualizarFiltro(); // Ejecutar al inicio

        // Acción del botón global actualizada
        document.getElementById('btnGlobal').addEventListener('click', function(){
            var caMaId = document.getElementById('selectedCaMaId').value;
            if(!caMaId){
                alert('Seleccione Carrera/Cohorte y Materia antes de ir a Asistencia Global.');
                return;
            }
            // Envia selectedCaMaId directamente
            var qs = '?selectedCaMaId=' + encodeURIComponent(caMaId) + '&_global=1';
            window.location.href = '/Asistencias/Index' + qs;
        });
    });
</script>

