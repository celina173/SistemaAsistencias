@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Sistema de Asistencias</title>
    <!-- Token para que el JS de sincronización offline lo mande por header -->
    <meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
    <link rel="icon" type="image/png" href="~/images/logo.png" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- PWA: manifest + íconos + metadatos -->
    <partial name="_PwaHead" />
    <script>
        // Sincrónico y antes de pintar el body: si la PWA corre instalada (standalone),
        // marca <html> para que el CSS cambie el menú hamburguesa por la barra inferior
        (function () {
            var esStandalone = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true;
            if (esStandalone) document.documentElement.classList.add('pwa-standalone');
        })();
    </script>
</head>
<body class="@ViewData["BodyClass"]">
    <!-- Ticket 6.8: formulario oculto de logout. Los links "Cerrar Sesion"/"Salir" lo envían por POST
     (con token antiforgery) para que la cookie se invalide en el servidor y no se pueda disparar con un link. -->
    <form id="formLogout" asp-controller="Account" asp-action="Salir" method="post" style="display:none"></form>

    <partial name="_PwaInstallBanner" />

    <header class="top-header">
        <div class="menu-icon" id="toggleSidebar">
            <div class="bar"></div>
            <div class="bar"></div>
            <div class="bar"></div>
        </div>

        @{
            // Definimos las rutas y variables globales de la sesión
            string targetController = "Home";
            bool esDocente = false;
            bool esAdminODireccion = false;

            if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                if (User.IsInRole("Admin") || User.IsInRole("Dirección"))
                {
                    targetController = "Admin";
                    esAdminODireccion = true;
                }
                else if (User.IsInRole("Docente"))
                {
                    targetController = "Profesor";
                    esDocente = true;
                }
            }
        }

        <!-- TÍTULO:-->
        <a class="header-title" asp-controller="@targetController" asp-action="Index" style="text-decoration: none; color: inherit; cursor: pointer; display: flex; flex-direction: column; align-items: center;">
            <div class="title-small">INSTITUTO N° 124</div>
            <div class="title-large">SISTEMA DE ASISTENCIAS</div>
        </a>

        <!-- LOGO:-->
        <div class="header-logo">
            <a asp-controller="@targetController" asp-action="Index">
                <img src="~/images/logo.png" alt="IS 124" class="logo-img">
            </a>
        </div>
    </header>

    <nav class="sidebar" id="sidebarMenu">
        <ul class="sidebar-links">
            <!-- INICIO INTELIGENTE -->
            <li>
                <a asp-controller="@targetController" asp-action="Index"><span class="menu-arrow">➔</span>Inicio</a>
            </li>
            
            <!-- CALENDARIO INTELIGENTE -->
            <li>
                @if (esDocente)
                {
                    // Buscamos si el docente ya eligió una materia
                    var currentCaMaId = Context.Request.Query["caMaId"].ToString();
                    if (string.IsNullOrEmpty(currentCaMaId)) {
                        currentCaMaId = Context.Request.Query["CaMaId"].ToString();
                    }
                    
                    if (!string.IsNullOrEmpty(currentCaMaId))
                    {
                        <!-- ACÁ ESTÁ LA CLAVE: Lo manda a la grilla de porcentajes -->
                        <a asp-controller="Asistencias" asp-action="AsistenciaGlobal" asp-route-caMaId="@currentCaMaId"><span class="menu-arrow">➔</span>Calendario</a>
                    }
                    else
                    {
                        <a asp-controller="Profesor" asp-action="Index"><span class="menu-arrow">➔</span>Calendario</a>
                    }
                }
                else
                {
                    <a asp-controller="Asistencias" asp-action="AsistenciaGlobal"><span class="menu-arrow">➔</span>Calendario</a>
                }
            </li>

            <!-- Ticket 6.8: antes iba a Login (solo mostraba la pantalla y la sesión quedaba abierta); ahora envía formLogout. -->
            <li>
                <a href="#" onclick="document.getElementById('formLogout').submit(); return false;"><span class="menu-arrow">➔</span>Cerrar Sesion</a>
            </li>
        </ul>
    </nav>

    <!-- Barra inferior PWA INTELIGENTE -->
    <nav class="pwa-bottom-nav" id="pwaBottomNav">
        <a asp-controller="@targetController" asp-action="Index" class="pwa-bottom-nav-item">
            <i class="bi bi-house"></i>
            <span>Inicio</span>
        </a>
        
        @if (esDocente)
        {
            var currentCaMaId = Context.Request.Query["caMaId"].ToString();
            if (string.IsNullOrEmpty(currentCaMaId)) {
                currentCaMaId = Context.Request.Query["CaMaId"].ToString();
            }

            if (!string.IsNullOrEmpty(currentCaMaId))
            {
                <a asp-controller="Profesor" asp-action="Asistencia" asp-route-caMaId="@currentCaMaId" class="pwa-bottom-nav-item">
                    <i class="bi bi-calendar3"></i><span>Calendario</span>
                </a>
            }
            else
            {
                <a asp-controller="Profesor" asp-action="Index" class="pwa-bottom-nav-item">
                    <i class="bi bi-calendar3"></i><span>Calendario</span>
                </a>
            }
        }
        else
        {
            <a asp-controller="Asistencias" asp-action="AsistenciaGlobal" class="pwa-bottom-nav-item">
                <i class="bi bi-calendar3"></i>
                <span>Calendario</span>
            </a>
        }
        
        <!-- Ticket 6.8: mismo cambio que el menú lateral, para la barra inferior de la PWA. -->
        <a href="#" onclick="document.getElementById('formLogout').submit(); return false;" class="pwa-bottom-nav-item">            
            <i class="bi bi-box-arrow-right"></i>
            <span>Salir</span>
        </a>
    </nav>

    <div class="header-divider"></div>

    @RenderBody()

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/script.js" asp-append-version="true"></script>
    @if (esDocente || esAdminODireccion)
    {
        <!-- Frente 7 (PWA offline): se carga también para Admin/Dirección (ticket 8.2) --
             se había perdido esta condición en un cambio anterior, dejando sin la cola
             offline a la pantalla de Asistencia del Admin otra vez. -->
        <script src="~/lib/dexie/dist/dexie.min.js"></script>
        <script src="~/js/offline-asistencia.js" asp-append-version="true"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
