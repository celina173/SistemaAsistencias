<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Sistema de Asistencias</title>
    <link rel="icon" type="image/png" href="~/images/logo.png" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body class="@ViewData["BodyClass"]">

    <header class="top-header">
        <div class="menu-icon" id="toggleSidebar">
            <div class="bar"></div>
            <div class="bar"></div>
            <div class="bar"></div>
        </div>

        @{
            // Definimos las rutas por defecto (para Alumnos o usuarios no logueados)
            string targetController = "Home";

            // Verificamos el rol usando los claims de la sesión que se crean en el Login
            if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                if (User.IsInRole("Admin") || User.IsInRole("Dirección"))
                {
                    targetController = "Admin";
                }
                else if (User.IsInRole("Docente"))
                {
                    targetController = "Profesor";
                }
            }
        }

        <!-- TÍTULO:-->
        <a class="header-title" asp-controller="@targetController" asp-action="Index" style="text-decoration: none; color: inherit; cursor: pointer; display: flex; flex-direction: column; align-items: center;">
            <div class="title-small">SISTEMA</div>
            <div class="title-large">ASISTENCIAS</div>
        </a>

        <!-- LOGO:-->
        <div class="header-logo">
            <a asp-controller="@targetController" asp-action="Index">
                <img src="~/images/logo.png" alt="IS 124" class="logo-img">
            </a>
        </div>
    </header>

    <nav class="sidebar" id="sidebarMenu">
        <ul class="sidebar-links">
            <li>
                <span class="menu-arrow">➔</span>
                <a asp-controller="Home" asp-action="Index">Inicio</a>
            </li>
            @{
                // El docente no debería caer directo en el calendario general (que no tiene
                // selector de cátedra para él, solo para Admin/Dirección) sin haber elegido antes
                // qué carrera/materia está dictando — se lo manda primero a sus cátedras.
                bool esDocente = User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Docente");
            }
            <li>
                <span class="menu-arrow">➔</span>
                @if (esDocente)
                {
                    <a asp-controller="Profesor" asp-action="Index">Calendario</a>
                }
                else
                {
                    <a asp-controller="Asistencias" asp-action="AsistenciaGlobal">Calendario</a>
                }
            </li>
            @if (User.Identity != null && User.Identity.IsAuthenticated
                  && (User.IsInRole("Admin") || User.IsInRole("Dirección")))
            {
                <li>
                    <span class="menu-arrow">➔</span>
                    <a asp-controller="Admin" asp-action="Index">Panel Admin</a>
                </li>
            }
            <li>
                <span class="menu-arrow">➔</span>
                <a asp-controller="Account" asp-action="Login">Cerrar Sesion</a>
            </li>
        </ul>
    </nav>

    <div class="header-divider"></div>

    @RenderBody()

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/script.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
