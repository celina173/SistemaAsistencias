@{
    ViewData["Title"] = "Error del Servidor";
}

<div class="auth-wrapper-global">
    <div class="auth-card" style="text-align: center;">
        <div class="auth-header">
            <div class="auth-title">
                <span class="title-small">ERROR 500</span>
                <span class="title-large">Falla Interna</span>
            </div>
        </div>
        <div class="header-divider-auth"></div>

        <h2 class="form-title-auth" style="color: #ef4444;">Ocurrió un error inesperado</h2>
        <p class="auth-instruction">
            Estamos teniendo inconvenientes para procesar tu solicitud en este momento (por ejemplo, al registrar o consultar datos). Por favor, intenta nuevamente más tarde.
        </p>

        <div class="button-container-auth" style="margin-top: 20px;">
            <a href="~/Home/Index" class="btn-enviar-recupero" style="text-decoration: none; display: inline-block; text-align: center;">
                Volver al Inicio
            </a>
        </div>
    </div>
</div>
