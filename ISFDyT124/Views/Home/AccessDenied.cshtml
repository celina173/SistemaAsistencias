@{
    ViewData["Title"] = "Acceso No Autorizado";
}

<div class="auth-wrapper-global">
    <div class="auth-card" style="text-align: center;">
        <div class="auth-header">
            <div class="auth-title">
                <span class="title-small">SISTEMA ACADÉMICO</span>
                <span class="title-large">Restringido</span>
            </div>
        </div>
        <div class="header-divider-auth"></div>

        <h2 class="form-title-auth" style="color: #ef4444;">Acceso No Autorizado</h2>
        <p class="auth-instruction">
            No cuentas con los permisos necesarios (Rol Admin) para acceder a esta sección del sistema.
        </p>

        <div class="button-container-auth" style="margin-top: 20px;">
            <a href="~/Home/Index" class="btn-enviar-recupero" style="text-decoration: none; display: inline-block; text-align: center;">
                Volver al Inicio
            </a>
        </div>
    </div>
</div>