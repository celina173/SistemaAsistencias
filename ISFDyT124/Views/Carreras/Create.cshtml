@model ISFDyT124.Models.Carrera

@{
    ViewData["Title"] = "Agregar Carrera";
    ViewData["BodyClass"] = "agregar-page";
}

<div class="admin-banner">
    CARRERAS
</div>

<div class="page-title-container">
    <h2 class="page-main-title">Agregar Carrera</h2>
</div>

<main class="main-container-form">
    <div class="form-card">
        <form asp-action="Create" class="form-grid">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="input-field">
                <label asp-for="CaDenominacion"></label>
                <input asp-for="CaDenominacion" placeholder="Ej: Tec. Sup. en Desarrollo de Software" autocomplete="off">
                <span asp-validation-for="CaDenominacion" class="text-danger"></span>
            </div>

            <div class="form-buttons">
                <a asp-action="Index" class="btn-cancel" style="text-decoration:none; text-align:center;">Cancelar</a>
                <button type="submit" class="btn-save">Guardar</button>
            </div>
        </form>
    </div>
</main>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
