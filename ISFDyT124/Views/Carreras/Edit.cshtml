@model ISFDyT124.Models.Carrera

@{
    ViewData["Title"] = "Editar Carrera";
    ViewData["BodyClass"] = "agregar-page";
}

<!-- BANNER OFICIAL -->
<div class="info-banner">
    <div class="info-col-left">
        <p class="info-bold">PANEL DE CONTROL</p>
    </div>
    <div class="info-col-right">
        <p class="info-bold">ADMINISTRADOR</p>
    </div>
</div>

<div class="page-title-container">
    <h2 class="page-main-title">Editar Carrera</h2>
</div>

<main class="main-container-form">
    <div class="form-card">
        <form asp-action="Edit" class="form-grid">
            <div asp-validation-summary="ModelOnly" class="text-danger" style="grid-column: span 2;"></div>
            <input type="hidden" asp-for="CaId" />

            <!-- El campo ocupa todo el ancho de la tarjeta -->
            <div class="input-field" style="grid-column: span 2;">
                <label asp-for="CaDenominacion"></label>
                <input asp-for="CaDenominacion" autocomplete="off">
                <span asp-validation-for="CaDenominacion" class="text-danger"></span>
            </div>

            <div class="form-buttons" style="grid-column: span 2; display: flex; justify-content: flex-end; gap: 20px; margin-top: 20px;">
                <a asp-action="Index" class="btn-cancel" style="text-decoration:none; text-align:center;">Cancelar</a>
                <button type="submit" class="btn-save">Guardar Cambios</button>
            </div>
        </form>
    </div>
</main>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
