@model ISFDyT124.Models.Carrera

@{
    ViewData["Title"] = "Detalle Carrera";
    ViewData["BodyClass"] = "agregar-page";
}

<div class="admin-banner">
    CARRERAS
</div>

<div class="page-title-container">
    <h2 class="page-main-title">Detalle Carrera</h2>
</div>

<main class="main-container-form">
    <div class="form-card">
        <div class="input-field">
            <label>@Html.DisplayNameFor(model => model.CaId)</label>
            <input value="@Model.CaId" readonly>
        </div>

        <div class="input-field">
            <label>@Html.DisplayNameFor(model => model.CaDenominacion)</label>
            <input value="@Model.CaDenominacion" readonly>
        </div>

        <div class="form-buttons">
            <a asp-action="Index" class="btn-cancel" style="text-decoration:none; text-align:center;">Volver</a>
            <a asp-action="Edit" asp-route-CaId="@Model.CaId" class="btn-save" style="text-decoration:none; text-align:center;">Editar</a>
        </div>
    </div>
</main>
