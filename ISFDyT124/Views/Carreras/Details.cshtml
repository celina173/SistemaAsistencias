
@model ISFDyT124.Models.Carrera

@{
    ViewData["Title"] = "Detalle Carrera";
    ViewData["BodyClass"] = "agregar-page";

    var relacion = Model.CarreraCohortes?
        .OrderBy(cc => cc.CaCoId)
        .FirstOrDefault();
}

<div class="admin-banner">
    CARRERAS
</div>

<div class="page-title-container">
    <h2 class="page-main-title">Detalle Carrera</h2>
</div>

<main class="main-container-form">
    <div class="form-card">

        <div class="input-field">
            <label>ID Carrera</label>
            <input value="@Model.CaId" readonly />
        </div>

        <div class="input-field" style="grid-column: span 2;">
            <label>Denominación</label>
            <input value="@Model.CaDenominacion" readonly />
        </div>

        <div class="input-field">
            <label>Año de Cohorte</label>
            <input value="@(relacion?.Cohorte?.CoAnio.ToString() ?? "Sin cohorte")"
                   readonly />
        </div>

        <div class="input-field">
            <label>Fecha inicio del año</label>
            <input value="@(relacion?.CaCoFechaInicio?.ToString("dd/MM/yyyy") ?? "Sin configurar")"
                   readonly />
        </div>

        <div class="input-field">
            <label>Fecha finalización del año</label>
            <input value="@(relacion?.CaCoFechaFin?.ToString("dd/MM/yyyy") ?? "Sin configurar")"
                   readonly />
        </div>

        <div class="form-buttons"
             style="grid-column: span 2; display: flex; justify-content: flex-end; gap: 20px; margin-top: 20px;">

            <a asp-action="Index"
               class="btn-cancel"
               style="text-decoration: none; text-align: center;">
                Volver
            </a>

            <a asp-action="Edit"
               asp-route-CaId="@Model.CaId"
               class="btn-save"
               style="text-decoration: none; text-align: center;">
                Editar
            </a>
        </div>
    </div>
</main>
