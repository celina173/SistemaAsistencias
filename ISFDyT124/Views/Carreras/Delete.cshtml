@model ISFDyT124.Models.Carrera

@{
    ViewData["Title"] = "Eliminar Carrera";
    ViewData["BodyClass"] = "agregar-page";
}

<div class="admin-banner">
    CARRERAS
</div>

<div class="page-title-container">
    <h2 class="page-main-title">Eliminar Carrera</h2>
</div>

<main class="main-container-form">
    <div class="form-card">
        <h3>¿Está seguro de eliminar esta carrera?</h3>

        <div class="input-field">
            <label>@Html.DisplayNameFor(model => model.CaId)</label>
            <input value="@Model.CaId" readonly>
        </div>

        <div class="input-field">
            <label>@Html.DisplayNameFor(model => model.CaDenominacion)</label>
            <input value="@Model.CaDenominacion" readonly>
        </div>

        <form asp-action="Delete">
            <input type="hidden" asp-for="CaId" />
            <div class="form-buttons">
                <a asp-action="Index" class="btn-cancel" style="text-decoration:none; text-align:center;">Cancelar</a>
                <button type="submit" class="btn-save">Eliminar</button>
            </div>
        </form>
    </div>
</main>
