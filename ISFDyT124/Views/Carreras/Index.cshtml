@model IEnumerable<ISFDyT124.Models.Carrera>

@{
    ViewData["Title"] = "Carreras";
    ViewData["BodyClass"] = "gestion-page";
}

<style>
    /* Estilos exclusivos para los botones de paginación */
    .btn-page {
        padding: 6px 12px;
        border: 1px solid #cbd5e1;
        background: white;
        border-radius: 6px;
        cursor: pointer;
        color: #003366;
        font-weight: bold;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .btn-page:hover:not(:disabled) {
        background: #f8fafc;
        border-color: #003366;
        color: #003366;
    }
    .btn-page:disabled {
        opacity: 0.4;
        cursor: not-allowed;
        background: #f1f5f9;
    }
</style>

<div class="info-banner">
    <div class="info-col-left">
        <p class="info-bold">PANEL DE CONTROL</p>
    </div>
    <div class="info-col-right">
        <p class="info-bold">ADMINISTRADOR</p>
    </div>
</div>

<div class="page-title-container">
    <h2 class="page-main-title">Gestión Carreras</h2>
</div>

<main class="main-container-global">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="info-banner" style="background-color: #d1fae5 !important; border-color: #a7f3d0 !important; margin-bottom: 15px !important;">
            <div class="info-col-left"><p class="info-bold" style="color: #065f46 !important;">@TempData["SuccessMessage"]</p></div>
        </div>
    }

    <!-- BARRA DE HERRAMIENTAS: Buscador y Botón Agregar -->
    <div class="toolbar-container">
        <div class="search-box">
            <input type="text" id="inputBusqueda" placeholder="Buscar por ID o nombre de carrera..." autocomplete="off" data-lpignore="true">
            <button class="btn-search" id="btnBuscar" type="button" style="cursor:default;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            </button>
        </div>

        <div class="add-btn-container">
            <a asp-action="Create" class="btn-add" id="btnAgregar" style="text-decoration: none; display: flex; align-items: center; justify-content: center;">+</a>
        </div>
    </div>

    <!-- TABLA GLOBAL -->
    <div class="global-table-container">
        <table class="global-table crud-carreras table-responsive-stack">
            <thead>
                <tr>
                    <th class="sortable" data-type="number" style="cursor:pointer;">
                        <div class="sort-header" style="justify-content: center;">
                            @Html.DisplayNameFor(model => model.CaId) <span class="sort-indicator" style="font-size:0.8em; margin-left:4px;">▲</span>
                        </div>
                    </th>
                    <th class="align-left sortable" data-type="text" style="cursor:pointer;">
                        <div class="sort-header">
                            @Html.DisplayNameFor(model => model.CaDenominacion) <span class="sort-indicator" style="font-size:0.8em; margin-left:4px;">⇅</span>
                        </div>
                    </th>
                    <th>ACCIONES</th>
                </tr>
            </thead>
            <tbody id="tableBody">
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td data-label="@Html.DisplayNameFor(m => m.CaId)" style="text-align: center;">@Html.DisplayFor(modelItem => item.CaId)</td>
                            <td class="align-left" data-label="@Html.DisplayNameFor(m => m.CaDenominacion)">@Html.DisplayFor(modelItem => item.CaDenominacion)</td>
                            <td class="action-cell" data-label="Acciones">
                                <div class="action-buttons">
                                    <a asp-action="Edit" asp-route-CaId="@item.CaId" class="icon-btn btn-edit" title="Editar">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 1 1 3 3L12 15l-4 1 1-4Z"></path></svg>
                                    </a>
                                    <a asp-action="Details" asp-route-CaId="@item.CaId" class="icon-btn" title="Detalles">📋</a>
                                    <a asp-action="Delete" asp-route-CaId="@item.CaId" class="icon-btn" title="Eliminar">🗑️</a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr id="emptyRow">
                        <td colspan="3" style="text-align:center; padding: 20px;">No hay carreras cargadas todavía.</td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- PAGINACIÓN -->
        <div class="pagination-container" style="display: flex; justify-content: space-between; align-items: center; margin-top: 15px; padding: 15px 0; border-top: 1px solid #e2e8f0;">
            <div class="pagination-info" style="font-size: 0.9rem; color: #64748b; font-weight: 500;">
                Mostrando <span id="pageStart">0</span> a <span id="pageEnd">0</span> de <span id="totalItems">0</span> carreras
            </div>
            <div class="pagination-controls" style="display: flex; gap: 8px; align-items: center;">
                <button id="btnFirst" class="btn-page" title="Primera página">&laquo;</button>
                <button id="btnPrev" class="btn-page" title="Página anterior">&lsaquo;</button>
                <span id="pageIndicator" style="padding: 0 10px; font-size: 0.9rem; font-weight: 600; color: #003366;">Página 1</span>
                <button id="btnNext" class="btn-page" title="Página siguiente">&rsaquo;</button>
                <button id="btnLast" class="btn-page" title="Última página">&raquo;</button>
            </div>
        </div>
    </div>
</main>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const table = document.querySelector('.crud-carreras');
        if (!table) return;

        const tbody = document.getElementById('tableBody');
        let allRows = Array.from(tbody.querySelectorAll('tr'));
        
        if (allRows.length === 1 && allRows[0].id === 'emptyRow') return;

        const headers = Array.from(table.querySelectorAll('thead th'));
        const collator = new Intl.Collator('es', { sensitivity: 'base', numeric: true });

        const inputBusqueda = document.getElementById('inputBusqueda');
        const btnFirst = document.getElementById('btnFirst');
        const btnPrev = document.getElementById('btnPrev');
        const btnNext = document.getElementById('btnNext');
        const btnLast = document.getElementById('btnLast');
        const pageStart = document.getElementById('pageStart');
        const pageEnd = document.getElementById('pageEnd');
        const totalItems = document.getElementById('totalItems');
        const pageIndicator = document.getElementById('pageIndicator');

        let activeCol = 0; // Ordenar por ID por defecto
        let isAsc = true;
        let activeTh = headers[0];

        let currentPage = 1;
        const itemsPerPage = 20; // 20 registros por página
        let filteredRows = [...allRows];

        function updateTable() {
            const total = filteredRows.length;
            const totalPages = Math.ceil(total / itemsPerPage) || 1;
            
            if (currentPage > totalPages) currentPage = totalPages;
            if (currentPage < 1) currentPage = 1;

            const startIndex = (currentPage - 1) * itemsPerPage;
            const endIndex = Math.min(startIndex + itemsPerPage, total);

            totalItems.textContent = total;
            pageStart.textContent = total === 0 ? 0 : startIndex + 1;
            pageEnd.textContent = endIndex;
            pageIndicator.textContent = `Página ${currentPage} de ${totalPages}`;

            btnFirst.disabled = currentPage === 1;
            btnPrev.disabled = currentPage === 1;
            btnNext.disabled = currentPage === totalPages;
            btnLast.disabled = currentPage === totalPages;

            tbody.innerHTML = '';
            if (total === 0) {
                const tr = document.createElement('tr');
                const td = document.createElement('td');
                td.colSpan = 3;
                td.style.textAlign = 'center';
                td.style.padding = '20px';
                td.textContent = 'No se encontraron carreras con esa búsqueda.';
                tr.appendChild(td);
                tbody.appendChild(tr);
            } else {
                const rowsToShow = filteredRows.slice(startIndex, endIndex);
                tbody.append(...rowsToShow);
            }
        }

        function sortRows() {
            const isNumber = activeTh.getAttribute('data-type') === 'number';
            
            filteredRows.sort((a, b) => {
                const textA = a.children[activeCol]?.textContent.trim() ?? '';
                const textB = b.children[activeCol]?.textContent.trim() ?? '';
                
                let valA = isNumber ? (parseFloat(textA.replace(',', '.')) || 0) : textA;
                let valB = isNumber ? (parseFloat(textB.replace(',', '.')) || 0) : textB;

                let comparison = 0;
                if (isNumber) {
                    comparison = valA - valB;
                } else {
                    comparison = collator.compare(valA, valB);
                }
                return isAsc ? comparison : -comparison;
            });
            updateTable();
        }

        function filterRows() {
            const query = inputBusqueda.value.toLowerCase().trim();
            if (!query) {
                filteredRows = [...allRows];
            } else {
                filteredRows = allRows.filter(row => {
                    // Filtramos buscando en la Columna 0 (ID) y Columna 1 (Nombre)
                    const idCarrera = row.children[0]?.textContent.toLowerCase() ?? '';
                    const nombreCarrera = row.children[1]?.textContent.toLowerCase() ?? '';
                    
                    return idCarrera.includes(query) || nombreCarrera.includes(query);
                });
            }
            currentPage = 1; 
            sortRows();
        }

        inputBusqueda.addEventListener('input', filterRows);

        btnFirst.addEventListener('click', () => { currentPage = 1; updateTable(); });
        btnPrev.addEventListener('click', () => { currentPage--; updateTable(); });
        btnNext.addEventListener('click', () => { currentPage++; updateTable(); });
        btnLast.addEventListener('click', () => { 
            currentPage = Math.ceil(filteredRows.length / itemsPerPage); 
            updateTable(); 
        });

        table.querySelector('thead').addEventListener('click', function (e) {
            const th = e.target.closest('th.sortable');
            if (!th) return;

            const colIndex = headers.indexOf(th);
            
            if (activeCol === colIndex) {
                isAsc = !isAsc;
            } else {
                if (activeTh) {
                    activeTh.classList.remove('sorted-asc', 'sorted-desc');
                    const prevIndicator = activeTh.querySelector('.sort-indicator');
                    if (prevIndicator) prevIndicator.textContent = '⇅';
                }
                activeCol = colIndex;
                activeTh = th;
                isAsc = true;
            }

            th.classList.remove('sorted-asc', 'sorted-desc');
            th.classList.add(isAsc ? 'sorted-asc' : 'sorted-desc');
            const indicator = th.querySelector('.sort-indicator');
            if (indicator) {
                indicator.textContent = isAsc ? '▲' : '▼';
            }

            sortRows();
        });

        // Inicializar ordenando por la primera columna (ID Carrera)
        sortRows();
    });
</script>
}
