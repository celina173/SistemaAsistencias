@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login IS 124</title>
    <link rel="icon" type="image/png" href="~/images/logo.png" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true">
</head>
<body class="login-page">
    <div class="login-card">
        <div class="logo-container">
            <img src="~/images/logo.png" alt="IS 124 Logo" class="logo-img">
        </div>

        <form id="loginForm" method="post" action="/Account/Login">
            @Html.AntiForgeryToken()
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alerta-error" role="alert">
                    <svg class="icono-alerta" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="8" x2="12" y2="12"></line>
                        <line x1="12" y1="16" x2="12.01" y2="16"></line>
                    </svg>
                    <div class="alerta-texto">
                        @Html.ValidationSummary(true, "")
                    </div>
                </div>
            }
            <div class="input-group">
                <label for="usuario">Usuario</label>
                <input type="text" id="usuario" name="usuario" placeholder="Ingresá tu usuario" required>
            </div>

            <div class="input-group">
                <label for="contrasena">Contraseña</label>
                <input type="password" id="contrasena" name="contrasena" placeholder="••••••••" required>
            </div>

            <button type="submit" class="btn-submit" aria-label="Ingresar">
                <span class="arrow">➔</span>
            </button>
        </form>

        <div class="link-container">
            <a href="recupero-contraseña.html" class="forgot-password">Olvidé mi contraseña</a>
        </div>
    </div>

    <script src="~/js/script.js"></script>
</body>
</html>